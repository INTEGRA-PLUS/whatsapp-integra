# Copy to .env.docker (gitignored) and fill in. Compose reads variables from
# this file via:  docker compose --env-file .env.docker ...
# Do NOT commit the populated file — it holds production secrets.

# --- App ---------------------------------------------------------------------
APP_NAME="WhatsApp API Manager"
APP_ENV=production
APP_KEY=                       # generate with: docker compose run --rm app php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://your-domain.example
APP_TIMEZONE=America/Bogota
APP_LOCALE=es

# Image to pull/run. Override per-environment in CI/CD.
APP_IMAGE=whatsapp-integra:latest
APP_PORT=8080

# --- Logging -----------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# --- Database (MySQL) --------------------------------------------------------
DB_DATABASE=whatsapp_integra
DB_USERNAME=whatsapp_integra
DB_PASSWORD=change-me-strong-password
DB_ROOT_PASSWORD=change-me-different-strong-password

# --- Redis -------------------------------------------------------------------
REDIS_PASSWORD=null

# --- Drivers (Redis-backed in production) -----------------------------------
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis
# Para activar las llamadas en tiempo real pon: reverb
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local

# --- Reverb (websockets, llamadas en tiempo real) ----------------------------
# Genera credenciales propias para producción (cualquier cadena aleatoria sirve;
# deben coincidir en el backend). El APP_KEY se reutiliza para el cliente (VITE).
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Host/puerto PÚBLICO al que se conecta el navegador (tu dominio; el websocket
# pasa por nginx en la ruta /app). NO uses "reverb" aquí (ese es el nombre
# interno que ya configura docker-compose para el backend).
VITE_REVERB_HOST=your-domain.example
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

# --- Meta WhatsApp API -------------------------------------------------------
ACCESS_TOKEN_META=
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
META_API_VERSION=v21.0
# La Calling API requiere una versión más reciente del Graph API
META_CALLING_API_VERSION=v23.0

# --- Mail --------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@your-domain.example
MAIL_FROM_NAME="${APP_NAME}"

# --- Scaling (prod overlay) --------------------------------------------------
QUEUE_REPLICAS=2
