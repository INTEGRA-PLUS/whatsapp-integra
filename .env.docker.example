# Copy to .env.docker (gitignored) and fill in. Compose reads variables from
# this file via:  docker compose --env-file .env.docker ...
# Do NOT commit the populated file — it holds production secrets.

# --- App ---------------------------------------------------------------------
APP_NAME="WhatsApp API Manager"
APP_ENV=production
APP_KEY=                       # generate with: docker compose run --rm app php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://your-domain.example
APP_TIMEZONE=America/Bogota
APP_LOCALE=es

# Image to pull/run. Override per-environment in CI/CD.
APP_IMAGE=whatsapp-integra:latest
APP_PORT=8080

# --- Logging -----------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# --- Database (MySQL) --------------------------------------------------------
DB_DATABASE=whatsapp_integra
DB_USERNAME=whatsapp_integra
DB_PASSWORD=change-me-strong-password
DB_ROOT_PASSWORD=change-me-different-strong-password

# --- Redis -------------------------------------------------------------------
REDIS_PASSWORD=null

# --- Drivers (Redis-backed in production) -----------------------------------
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis
# Tiempo real del chat (mensajes, cambios de conversación, presencia,
# notificaciones y llamadas). Con `log` todo sigue funcionando, pero solo se
# refresca con el poll de respaldo.
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local

# --- Reverb (websockets: chat, presencia, notificaciones y llamadas) ---------
# Genera credenciales propias para producción (cualquier cadena aleatoria sirve;
# deben coincidir en el backend). El APP_KEY se reutiliza para el cliente (VITE).
# Las tres son OBLIGATORIAS: sin ellas el stack no levanta, a propósito.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Host/puerto PÚBLICO al que se conecta el navegador (tu dominio; el websocket
# pasa por nginx en la ruta /app). NO uses "reverb" aquí (ese es el nombre
# interno que ya configura docker-compose para el backend).
VITE_REVERB_HOST=your-domain.example
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

# --- Meta WhatsApp API -------------------------------------------------------
ACCESS_TOKEN_META=
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
# App secrets de todas las apps de Meta que entregan a este servidor.
#
# Integra e Ispintegra usan el MISMO callback y cada una firma con su propio
# secreto, así que van todas aquí separadas por coma. Sin ninguna configurada
# el webhook rechaza TODO con 403.
#
# Formato recomendado "<app_id>:<secreto>": además de validar la firma, permite
# saber qué secreto va con qué app para armar el app access token
# "app_id|app_secret" (lo necesita la suscripción del webhook de llamadas).
# Un secreto suelto sin app_id también se acepta, pero sólo sirve para firmas.
#
#   META_APP_SECRETS="1862365350983129:<secreto_integra>,865904982715022:<secreto_ispintegra>"
#
# Si se deja vacío, se usa META_APP_SECRET.
META_APP_SECRETS=""

# El registro insertado (Embedded Signup): el botón «Conectar WhatsApp Business»
# de la pantalla de instancias.
#
# Faltando cualquiera de las dos —o el secreto de esa app en META_APP_SECRETS—,
# el botón sencillamente NO SE PINTA: `/api/embedded-signup/config` responde
# `enabled: false` y el componente se calla, sin error en pantalla ni en el log.
# Se sigue conectando a mano, que es lo que hace pensar que "se quitó una
# función" cuando en realidad falta una variable.
#
# Ninguna de las dos estaba en este ejemplo hasta el 15-sep-2026, así que el
# .env.docker de producción —copiado de aquí— tampoco las tenía: el botón
# funcionaba con una config cacheada dentro del contenedor y desapareció en
# cuanto se reconstruyó la imagen. Ver `docs/conexion-whatsapp.md`.
#
# META_ES_CONFIG_ID es el id de la configuración del registro insertado, el que
# sale en el panel de Meta (WhatsApp → Registro insertado). No es secreto.
META_APP_ID=
META_ES_CONFIG_ID=
# La versión de Graph de la VENTANA del registro, distinta a propósito de la de
# los envíos (META_API_VERSION).
META_ES_GRAPH_VERSION=v25.0

# Instagram. Al añadir el caso de uso de Instagram, Meta crea sola una app
# aparte —«Integra CRM-IG»— con App ID y clave secreta propios. Este App ID NO
# es META_APP_ID, y su clave secreta se AÑADE a META_APP_SECRETS como una
# entrada más ("<app_id>:<secreto>"): el validador de firmas prueba todas.
META_IG_APP_ID=
# Token del apretón de manos del webhook del tópico `instagram`. Si se deja
# vacío se usa META_WEBHOOK_VERIFY_TOKEN (con `?:`, no con el segundo argumento
# de env(): el compose la declara como ${VAR:-} y llega DEFINIDA y vacía, no
# ausente, y env() sólo aplica su valor por defecto cuando la clave no existe).
META_IG_WEBHOOK_VERIFY_TOKEN=

META_API_VERSION=v21.0
# La Calling API requiere una versión más reciente del Graph API
META_CALLING_API_VERSION=v23.0

# --- Mail --------------------------------------------------------------------
# De aquí sale el correo de "¿Olvidaste tu contraseña?", que es la única forma
# que tiene un usuario de volver a entrar por su cuenta. Con MAIL_HOST vacío
# el mailer cae a 127.0.0.1, donde no hay nada escuchando: el enlace no se
# envía y quien lo pidió recibe un aviso de que el correo no está configurado.
#
# Para Gmail: host smtp.gmail.com, puerto 587, MAIL_SCHEME=smtp, y como
# contraseña una "clave de aplicación" de la cuenta (la contraseña normal no
# vale desde que Google exige 2FA).
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_SCHEME=smtp
MAIL_USERNAME=
MAIL_PASSWORD=
# El remitente tiene que ser un dominio real: con el de ejemplo, Gmail y
# Outlook mandan el correo directo a spam, cuando no lo rechazan.
MAIL_FROM_ADDRESS=no-reply@your-domain.example
MAIL_FROM_NAME="${APP_NAME}"

# --- Scaling (prod overlay) --------------------------------------------------
QUEUE_REPLICAS=2

# ── Las cuatro funciones con IA ─────────────────────────────────────────────
#
# Las cuatro hablan con el MISMO n8n y con la MISMA cabecera `X-Api-Key`, así
# que las cuatro claves de abajo llevan el mismo valor. Están separadas por si
# algún día una función se muda a otro sitio, no porque hoy sean distintas.
#
# Recordar que el contenedor NO lee el `.env` del host: ponerlas sólo ahí es
# reconstruir sin efecto. La vía es este fichero + el bloque `x-app-env` del
# `docker-compose.yml`.
#
# Y la parte que se olvida: **con la clave vacía el flujo de n8n queda abierto**
# —se dispara desde internet sin credencial— y detrás hay un Ollama de pago.

# Menús de WhatsApp: entiende el mensaje del cliente y devuelve qué hacer.
AI_MENUS_WEBHOOK_URL=
AI_MENUS_API_KEY=
AI_MENUS_TIMEOUT=180
AI_MENUS_DEBOUNCE=6

# Chat con IA: flujo aparte del de menús, con su propio contrato.
AI_CHAT_WEBHOOK_URL=
AI_CHAT_API_KEY=

# Los documentos que sube una empresa para entrenar a su IA. El modelo corre en
# el propio servidor (contenedor `ollama` del compose de n8n), porque Ollama
# Cloud no ofrece embeddings y esta función va incluida en el plan sin cobrarse
# aparte: su coste tiene que ser fijo, no por consulta.
#
# Vacío = los documentos se buscan por palabras en vez de por significado. Peor,
# pero contesta.
#
# Cambiar el modelo obliga a `php artisan ia:revectorizar --todos`.
EMBEDDINGS_URL=
EMBEDDINGS_MODEL=paraphrase-multilingual
AI_CHAT_TIMEOUT=180

# Semáforo de emociones: es la SEGUNDA capa. La primera —el léxico en PHP— ya
# colorea conversaciones sin n8n, y sigue haciéndolo aunque esto esté vacío.
# Lo que se pierde sin configurar es el afinado del modelo, no el semáforo.
SENTIMIENTO_WEBHOOK_URL=
SENTIMIENTO_API_KEY=
SENTIMIENTO_TIMEOUT=45
SENTIMIENTO_DEBOUNCE=120

# ── Resumen de conversación con IA ──────────────────────────────────────────
# Webhook de n8n que devuelve {resumen, puntos, pendientes}. Sin él, el botón
# «Resumir» del chat avisa de que no está configurado en vez de fallar callado.
RESUMEN_WEBHOOK_URL=
RESUMEN_API_KEY=
# Corto a propósito: hay una persona esperando delante de un botón.
RESUMEN_TIMEOUT=30
