# App secrets de todas las apps de Meta que entregan a este servidor.
#
# Integra e Ispintegra usan el MISMO callback y cada una firma con su propio
# secreto, así que van todas aquí separadas por coma. Sin ninguna configurada
# el webhook rechaza TODO con 403.
#
# Formato recomendado "<app_id>:<secreto>": además de validar la firma, permite
# saber qué secreto va con qué app para armar el app access token
# "app_id|app_secret" (lo necesita la suscripción del webhook de llamadas).
# Un secreto suelto sin app_id también se acepta, pero sólo sirve para firmas.
#
#   META_APP_SECRETS="1862365350983129:<secreto_integra>,865904982715022:<secreto_ispintegra>"
#
# Si se deja vacío, se usa META_APP_SECRET.
META_APP_SECRETS=""

META_API_VERSION="v21.0"

# Software Integra — integración "Pagos a facturas":
# Integra es multi-tenant, cada empresa indica la URL de su entorno al conectar
# (se guarda en company_integrations.base_url). El redirect_uri es la URL de este
# wpp, así que basta con que APP_URL apunte a https://wpp.integracolombia.com

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Reverb (websockets: chat, presencia, notificaciones y llamadas en tiempo real).
# Las tres credenciales son obligatorias: sin ellas no hay tiempo real (el chat
# se queda solo con el poll de respaldo). Cualquier cadena aleatoria sirve,
# mientras coincida entre el backend y el daemon.
# En local hay que levantar el daemon aparte:  php artisan reverb:start
# En Docker ya corre en su propio contenedor (servicio `reverb`).
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

CACHE_STORE=file
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Guardarraíl de la ventana de 24h de WhatsApp.
# Fuera de esa ventana Meta sólo acepta plantillas: el texto libre recibe un 200
# con wamid y falla después, por webhook. Los avisos que entran por
# /api/v1/messages/send salen igualmente, envueltos en la plantilla de respaldo
# de cada instancia; esto decide qué pasa con los que ni así pueden salir.
#   shadow  → se dejan pasar y quedan marcados (por defecto)
#   enforce → se rechazan con 422 y code "window_closed"
WHATSAPP_WINDOW_GUARD=shadow
# Encender el rechazo empresa por empresa, sin tocar el modo global (company_id
# separados por comas).
WHATSAPP_WINDOW_GUARD_COMPANIES=
